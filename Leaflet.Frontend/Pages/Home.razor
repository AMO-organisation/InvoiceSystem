@page "/"
@using Leaflet.Frontend.Contracts
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject MoneyFormatter Money

<PageTitle>Overview · Leaflet</PageTitle>

<PageHeader Eyebrow="Studio overview"
            Title="The ledger, at a glance."
            Lede="Live metrics from the backend. Invoice totals and statuses are computed server-side.">
    <Actions>
        <a href="invoices/new" class="btn btn-accent">New invoice</a>
        <a href="customers/new" class="btn btn-ghost">Add customer</a>
    </Actions>
</PageHeader>

@if (!_loaded)
{
    <p class="muted">Reading the ledger…</p>
}
else
{
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-label">Total invoiced</div>
            <div class="stat-value">@Money.Format(_totalInvoiced)</div>
            <div class="stat-note">All invoices in the ledger</div>
        </div>
        <div class="stat-card gold">
            <div class="stat-label">Outstanding</div>
            <div class="stat-value">@Money.Format(_outstanding)</div>
            <div class="stat-note">@_unpaidCount open invoice@(_unpaidCount == 1 ? string.Empty : "s")</div>
        </div>
        <div class="stat-card sage">
            <div class="stat-label">Collected</div>
            <div class="stat-value">@Money.Format(_collected)</div>
            <div class="stat-note">@_paidCount settled invoice@(_paidCount == 1 ? string.Empty : "s")</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Overdue</div>
            <div class="stat-value">@_overdueCount</div>
            <div class="stat-note">@_overdueCount invoice@(_overdueCount == 1 ? " is" : "s are") past due</div>
        </div>
    </div>

    @if (_summary.OverdueCount > 0)
    {
        <div class="notice notice-info">
            <span class="mono">!</span>
            <span>
                <strong>@_summary.OverdueCount invoice@(_summary.OverdueCount == 1 ? " is" : "s are") past due.</strong>
                Open the invoice list to review and follow up.
            </span>
        </div>
    }

    <div class="split-grid">
        <section class="panel">
            <div class="panel-head">
                <h2>Recent activity</h2>
                <a class="link-quiet" href="invoices">View all invoices →</a>
            </div>
            @if (_recent.Count == 0)
            {
                <EmptyState Mark="+" Title="No invoices yet" Message="Create your first invoice to start the ledger.">
                    <a href="invoices/new" class="btn btn-accent btn-sm">Create invoice</a>
                </EmptyState>
            }
            else
            {
                <div class="table-wrap">
                    <table class="ledger">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th class="hide-sm">Issued</th>
                                <th class="num">Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in _recent)
                            {
                                <tr>
                                    <td>
                                        <a class="cell-title mono" href="@InvoiceHref(invoice)">
                                            @invoice.InvoiceNumber
                                        </a>
                                    </td>
                                    <td>
                                        @invoice.CustomerName
                                        <span class="cell-sub">Due @invoice.DueDate.ToString("MMM d")</span>
                                    </td>
                                    <td class="mono hide-sm">@invoice.IssueDate.ToString("MMM d, yyyy")</td>
                                    <td class="num">@Money.Format(invoice.GrandTotal)</td>
                                    <td><span class="status-pill @StatusClass(invoice.Status)">@StatusLabel(invoice.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="stack">
            <section class="panel panel-pad">
                <div class="eyebrow">Studio pulse</div>
                <h2 style="font-size:1.45rem;margin-bottom:1rem;">Where things stand</h2>
                <div class="totals-row">
                    <span>Total invoices</span>
                    <span class="amount">@_summary.TotalInvoices</span>
                </div>
                <div class="totals-row">
                    <span>Customers</span>
                    <span class="amount">@_customerCount</span>
                </div>
                <div class="totals-row">
                    <span>Catalog items</span>
                    <span class="amount">@_productCount</span>
                </div>
                <hr class="divider" />
                <div class="totals-row">
                    <span>Paid</span>
                    <span class="amount">@_summary.PaidCount</span>
                </div>
                <div class="totals-row">
                    <span>Unpaid</span>
                    <span class="amount">@_summary.UnpaidCount</span>
                </div>
                <div class="totals-row">
                    <span>Overdue</span>
                    <span class="amount">@_summary.OverdueCount</span>
                </div>
            </section>

            <section class="panel panel-pad">
                <div class="eyebrow">Quick actions</div>
                <div class="d-grid gap-2">
                    <a href="invoices/new" class="btn btn-accent">Start an invoice</a>
                    <a href="customers" class="btn btn-ghost">Manage customers</a>
                    <a href="products" class="btn btn-ghost">Browse the catalog</a>
                </div>
            </section>
        </div>
    </div>
}

@code {
    private bool _loaded;
    private DashboardSummaryDto _summary = new(0, 0, 0, 0, 0, 0, new());
    private List<InvoiceDto> _recent = [];
    private decimal _totalInvoiced;
    private decimal _outstanding;
    private decimal _collected;
    private int _unpaidCount;
    private int _paidCount;
    private int _overdueCount;
    private int _customerCount;
    private int _productCount;

    protected override async Task OnInitializedAsync()
    {
        _summary = await Http.GetFromJsonAsync<DashboardSummaryDto>("api/dashboard/summary", JsonOptions)
            ?? new DashboardSummaryDto(0, 0, 0, 0, 0, 0, new());

        _recent = _summary.RecentInvoices;

        _totalInvoiced = _summary.TotalRevenue + _summary.TotalReceivables;
        _outstanding = _summary.TotalReceivables;
        _collected = _summary.TotalRevenue;
        _unpaidCount = _summary.UnpaidCount;
        _paidCount = _summary.PaidCount;
        _overdueCount = _summary.OverdueCount;

        _customerCount = (await CustomerService.GetAllAsync()).Count;
        _productCount = (await ProductService.GetAllAsync()).Count;

        _loaded = true;
    }

    private static string StatusLabel(Contracts.InvoiceStatus status) => status switch
    {
        Contracts.InvoiceStatus.Unpaid => "Issued",
        Contracts.InvoiceStatus.Cancelled => "Void",
        _ => status.ToString()
    };

    private static string StatusClass(Contracts.InvoiceStatus status) => status switch
    {
        Contracts.InvoiceStatus.Draft => "status-draft",
        Contracts.InvoiceStatus.Paid => "status-paid",
        Contracts.InvoiceStatus.Overdue => "status-overdue",
        Contracts.InvoiceStatus.Cancelled => "status-void",
        _ => "status-issued"
    };

    private static string InvoiceHref(InvoiceDto invoice) =>
        $"invoices/{invoice.Id}/print";

}


