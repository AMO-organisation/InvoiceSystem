@page "/settings"
@inject ISettingsService SettingsService
@inject MoneyFormatter Money

<PageTitle>Studio settings · Leaflet</PageTitle>

<PageHeader Eyebrow="Studio"
            Title="Settings"
            Lede="The studio identity and defaults that appear on every invoice. Changes apply to new invoices and future printouts.">
</PageHeader>

@if (_message is not null)
{
    <div class="notice notice-success">@_message</div>
}

@if (_error is not null)
{
    <div class="notice notice-error">@_error</div>
}

<div class="split-grid">
    <div class="stack">
        <section class="panel">
            <div class="panel-head">
                <h2>Studio identity</h2>
            </div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="field full">
                        <label class="form-label" for="company">Studio name</label>
                        <input id="company" class="form-control" @bind="_settings.CompanyName" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="email">Email</label>
                        <input id="email" type="email" class="form-control" @bind="_settings.Email" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="phone">Phone</label>
                        <input id="phone" class="form-control" @bind="_settings.Phone" />
                    </div>
                    <div class="field full">
                        <label class="form-label" for="logo">Logo URL</label>
                        <input id="logo" class="form-control" @bind="_settings.LogoUrl" placeholder="https://… or a data URL" />
                        <div class="form-text">Optional. A simple monogram is used when this is empty.</div>
                    </div>
                    <div class="field full">
                        <label class="form-label" for="street">Street</label>
                        <input id="street" class="form-control" @bind="_settings.Address.Street" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="city">City</label>
                        <input id="city" class="form-control" @bind="_settings.Address.City" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="state">State / region</label>
                        <input id="state" class="form-control" @bind="_settings.Address.State" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="postal">Postal code</label>
                        <input id="postal" class="form-control" @bind="_settings.Address.PostalCode" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="country">Country</label>
                        <input id="country" class="form-control" @bind="_settings.Address.Country" />
                    </div>
                    <div class="field full">
                        <label class="form-label" for="taxid">Tax ID</label>
                        <input id="taxid" class="form-control" @bind="_settings.TaxId" />
                    </div>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-head">
                <h2>Invoice defaults</h2>
            </div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="field">
                        <label class="form-label" for="currency-code">Currency code</label>
                        <input id="currency-code" class="form-control" @bind="_settings.CurrencyCode" placeholder="NGN" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="currency-symbol">Currency symbol</label>
                        <input id="currency-symbol" class="form-control" @bind="_settings.CurrencySymbol" placeholder="₦" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="tax">Default tax rate (%)</label>
                        <input id="tax" type="number" min="0" max="100" step="0.01" class="form-control" @bind="_settings.DefaultTaxRate" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="terms">Payment terms (days)</label>
                        <input id="terms" type="number" min="0" max="365" class="form-control" @bind="_settings.PaymentTermsDays" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="prefix">Invoice prefix</label>
                        <input id="prefix" class="form-control" @bind="_settings.InvoicePrefix" placeholder="INV" />
                    </div>
                    <div class="field">
                        <label class="form-label">Next number format</label>
                        <div class="form-control mono" style="background:var(--paper);color:var(--muted);">
                            @PrefixPreview-@DateTime.Today.Year-0001
                        </div>
                    </div>
                    <div class="field full">
                        <label class="form-label" for="footer">Invoice footer</label>
                        <textarea id="footer" class="form-control" rows="3" @bind="_settings.FooterText"></textarea>
                    </div>
                </div>
            </div>
            <div class="panel-head" style="justify-content:flex-end;border-bottom:0;border-top:1px solid var(--line);">
                <button class="btn btn-accent" @onclick="SaveAsync">Save settings</button>
            </div>
        </section>
    </div>

    <aside class="editor-side">
        <section class="panel panel-pad">
            <div class="eyebrow">On paper</div>
            <div class="settings-preview">
                @if (!string.IsNullOrWhiteSpace(_settings.LogoUrl))
                {
                    <img src="@_settings.LogoUrl" alt="" class="settings-logo" />
                }
                else
                {
                    <span class="settings-mark">L</span>
                }
                <div class="settings-company">@(string.IsNullOrWhiteSpace(_settings.CompanyName) ? "Your studio" : _settings.CompanyName)</div>
                <div class="muted" style="font-size:.78rem;">
                    @if (!_settings.Address.IsEmpty)
                    {
                        <div>@_settings.Address.ToSingleLine()</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_settings.Email))
                    {
                        <div>@_settings.Email</div>
                    }
                </div>
                <div class="settings-rule"></div>
                <div class="mono" style="font-size:.72rem;color:var(--muted);">INVOICE</div>
                <div class="settings-number">@PrefixPreview-@DateTime.Today.Year-0001</div>
                <div class="muted" style="font-size:.76rem;">Numbers are assigned when an invoice is finalized.</div>
                <div class="settings-rule"></div>
                <div class="settings-row">
                    <span class="muted">Example total</span>
                    <span class="mono">@PreviewMoney(1250m)</span>
                </div>
                <div class="settings-row">
                    <span class="muted">Default tax</span>
                    <span class="mono">@_settings.DefaultTaxRate.ToString("0.##")%</span>
                </div>
                <div class="settings-row">
                    <span class="muted">Terms</span>
                    <span class="mono">Net @_settings.PaymentTermsDays</span>
                </div>
            </div>
        </section>
    </aside>
</div>

@code {
    private CompanySettings _settings = new();
    private string? _message;
    private string? _error;

    private string PrefixPreview =>
        string.IsNullOrWhiteSpace(_settings.InvoicePrefix) ? "INV" : _settings.InvoicePrefix.Trim();

    protected override void OnInitialized()
    {
        _settings = SettingsService.Current;
    }

    private string PreviewMoney(decimal amount) =>
        $"{(_settings.CurrencySymbol is null ? string.Empty : _settings.CurrencySymbol)}{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private void SaveAsync()
    {
        _message = null;
        _error = null;

        if (string.IsNullOrWhiteSpace(_settings.CompanyName))
        {
            _error = "The studio name cannot be empty.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_settings.CurrencyCode) || string.IsNullOrWhiteSpace(_settings.CurrencySymbol))
        {
            _error = "Currency code and symbol are required.";
            return;
        }

        if (_settings.DefaultTaxRate is < 0m or > 100m)
        {
            _error = "Default tax rate must be between 0 and 100.";
            return;
        }

        if (_settings.PaymentTermsDays is < 0 or > 365)
        {
            _error = "Payment terms must be between 0 and 365 days.";
            return;
        }

        SettingsService.Update(_settings);
        _settings = SettingsService.Current;
        _message = "Settings saved for this session.";
    }
}
