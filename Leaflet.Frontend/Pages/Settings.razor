@page "/settings"
@inject ISettingsService SettingsService
@inject MoneyFormatter Money

<PageTitle>Business profile · Leaflet</PageTitle>

<PageHeader Eyebrow="Studio"
        Title="Business profile"
        Lede="The company identity and defaults that appear on every invoice. Stored in the backend and used for invoice branding and the default tax rate.">
</PageHeader>

@if (!_loaded)
{
    <p class="muted">Loading business profile…</p>
}
else
{
    @if (_message is not null)
    {
        <div class="notice notice-success">@_message</div>
    }

    @if (_error is not null)
    {
        <div class="notice notice-error">@_error</div>
    }

    <div class="panel">
        <div class="panel-body">
            <EditForm Model="_settings" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="field full">
                        <label class="form-label" for="company">Company name</label>
                        <InputText id="company" class="form-control" @bind-Value="_settings.CompanyName" />
                        <ValidationMessage For="() => _settings.CompanyName" />
                    </div>
                    <div class="field full">
                        <label class="form-label" for="address">Address</label>
                        <InputText id="address" class="form-control" @bind-Value="_settings.Address.Street" />
                        <ValidationMessage For="() => _settings.Address.Street" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="city">City</label>
                        <InputText id="city" class="form-control" @bind-Value="_settings.Address.City" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="email">Email</label>
                        <InputText id="email" type="email" class="form-control" @bind-Value="_settings.Email" />
                        <ValidationMessage For="() => _settings.Email" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="phone">Phone</label>
                        <InputText id="phone" class="form-control" @bind-Value="_settings.Phone" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="currency-symbol">Currency symbol</label>
                        <InputText id="currency-symbol" class="form-control" @bind-Value="_settings.CurrencySymbol" placeholder="₦" />
                        <ValidationMessage For="() => _settings.CurrencySymbol" />
                    </div>
                    <div class="field">
                        <label class="form-label" for="tax">Default tax rate (%)</label>
                        <InputNumber id="tax" class="form-control" @bind-Value="_settings.DefaultTaxRate" step="0.01" min="0" max="100" />
                        <ValidationMessage For="() => _settings.DefaultTaxRate" />
                    </div>
                    <div class="field full">
                        <label class="form-label" for="payment-instructions">Payment instructions</label>
                        <InputTextArea id="payment-instructions" class="form-control" rows="3" @bind-Value="_settings.PaymentInstructions" placeholder="Bank transfer details…" />
                    </div>
                </div>
                <div class="panel-head" style="justify-content:flex-end;border-bottom:0;border-top:1px solid var(--line);">
                    <button class="btn btn-accent" type="submit" disabled="@_busy">Save profile</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private CompanySettings _settings = new();
    private string? _message;
    private string? _error;
    private bool _loaded;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await SettingsService.LoadAsync();
        _settings = SettingsService.Current;
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _message = null;
        _error = null;

        if (string.IsNullOrWhiteSpace(_settings.CompanyName))
        {
            _error = "The company name cannot be empty.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_settings.Address.Street) || string.IsNullOrWhiteSpace(_settings.Address.City))
        {
            _error = "Address and city are required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_settings.Email) || string.IsNullOrWhiteSpace(_settings.Phone))
        {
            _error = "Email and phone are required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_settings.CurrencySymbol))
        {
            _error = "Currency symbol is required.";
            return;
        }
        if (_settings.DefaultTaxRate is < 0m or > 100m)
        {
            _error = "Default tax rate must be between 0 and 100.";
            return;
        }

        _busy = true;
        try
        {
            await SettingsService.UpdateAsync(_settings);
            _settings = SettingsService.Current;
            _message = "Business profile saved.";
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
